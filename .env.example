# ====================================================================
# BREVO EMAIL API & SMTP CONFIGURATION (Add these in Vercel Environment Variables)
# ====================================================================
BREVO_API_KEY=your_brevo_api_key_here
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_SENDER=ceaneazucena@gmail.com
MAIL_DEFAULT_SENDER=ceaneazucena@gmail.com

# ====================================================================
# SUPABASE CONFIGURATION (Optional - for database table storage)
# ====================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
